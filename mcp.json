{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bitwarden_safe": {
      "type": "stdio",
      "command": "./scripts/launch-bitwarden-safe-mcp",
      "args": ["${PLUGIN_ROOT}/server/index.mjs"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "BITWARDEN_SAFE_DATA_DIR": "${PLUGIN_DATA}",
        "BITWARDENCLI_APPDATA_DIR": "${PLUGIN_DATA}/bitwarden-cli",
        "BW_CLI_PATH": "${PLUGIN_ROOT}/node_modules/@bitwarden/cli/build/bw.js"
      }
    }
  }
}
